# Copy to .env for local runs. On GitHub Actions, add these as repository Secrets.
# Never commit the real .env file.

# --- LLM (at least one required; tried in config.yaml order) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Trends ---
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=auto-shorts/0.1 by u/YOUR_REDDIT_USERNAME

# --- Footage ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- YouTube upload (OAuth; get the refresh token with scripts/get_youtube_token.py) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Telegram review ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Instagram (optional) ---
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Optional: where run folders live (e.g. /content/drive/MyDrive/auto-shorts/runs in Colab) ---
RUNS_DIR=
